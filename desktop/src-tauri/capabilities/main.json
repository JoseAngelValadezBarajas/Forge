{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Only the bundled Forge main window receives the narrow desktop API commands.",
  "windows": ["main"],
  "permissions": [
    "allow-desktop-runtime-status",
    "allow-desktop-retry-start",
    "allow-desktop-api-request",
    "allow-desktop-save-download",
    "allow-desktop-cancel-api-request"
  ]
}
