{
  "name": "forge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "test": "vitest run && npm run check:architecture && node --test scripts/api-contract-verifier.test.mjs scripts/e2e-run-resources.test.mjs scripts/contrast.test.mjs && node scripts/verify-api-response-contracts.mjs",
    "test:coverage": "vitest run --coverage && npm run check:architecture && node --test scripts/api-contract-verifier.test.mjs scripts/e2e-run-resources.test.mjs scripts/contrast.test.mjs && node scripts/verify-api-response-contracts.mjs && node scripts/coverage-summary.mjs",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "test:isolation": "node ../scripts/verify_e2e_isolation.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
